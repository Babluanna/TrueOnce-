rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.get('uid', '') is string && data.get('uid', '').size() <= 128 &&
             data.get('email', '') is string &&
             data.get('displayName', '') is string &&
             data.get('role', 'user') in ['admin', 'user'] &&
             data.get('createdAt', 0) is number &&
             data.get('lastLogin', 0) is number &&
             data.get('totalUsageMs', 0) is number &&
             data.get('isLocked', false) is bool;
    }

    function isValidAppConfig(data) {
      return data.get('appName', 'TrueOnce') is string &&
             data.get('appIcon', '') is string &&
             data.get('isJailbreakMode', false) is bool &&
             data.get('features', {}) is map &&
             data.get('uiTheme', 'dark') in ['dark', 'light', 'system'] &&
             (!('geminiApiKey' in data) || (data.geminiApiKey is string && data.geminiApiKey.size() <= 512));
    }

    function isValidAdminAuditLog(data) {
      return data.adminId is string && data.adminId.size() <= 128 &&
             data.adminEmail is string && data.adminEmail.size() <= 256 &&
             data.action is string && data.action.size() <= 100 &&
             (!('target' in data) || (data.target is string && data.target.size() <= 256)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 1000)) &&
             data.timestamp is number;
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isSignedIn() && 
                      isOwner(userId) && 
                      isValidUserProfile(incoming());
      
      allow update: if (isOwner(userId) && 
                        isValidUserProfile(incoming()) && 
                        incoming().role == existing().role && // Prevent self-escalation
                        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin', 'usageStartTime', 'totalUsageMs', 'isLocked', 'lockedAt']))) || 
                      isAdmin();
      
      allow delete: if isAdmin();
      
      allow list: if isSignedIn();

      match /conversations/{convId} {
        allow read, write, delete: if isOwner(userId);
        
        match /messages/{msgId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    match /config/main {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidAppConfig(incoming());
    }

    match /config/connection_test {
      allow read: if isSignedIn();
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, list: if isAdmin();
    }

    match /logs/{logId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, list, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if isAdmin() && isValidAdminAuditLog(incoming());
      allow read, list: if isAdmin();
    }
  }
}
